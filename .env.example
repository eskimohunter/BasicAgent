# Copy to .env (in the current directory or next to agent.py) and edit.
# Real environment variables always take precedence over this file.

AGENT_BASE_URL=http://localhost:8080/v1
AGENT_API_KEY=none
AGENT_MODEL=local-model

# Optional second model for command summaries. Each falls back to the
# corresponding main setting above when left empty.
AGENT_SUMMARY_BASE_URL=
AGENT_SUMMARY_API_KEY=
AGENT_SUMMARY_MODEL=

# Context window in tokens; leave empty (or 0) to probe the server.
AGENT_CONTEXT_WINDOW=

# OpenAI-style aliases are also honoured:
# OPENAI_BASE_URL, OPENAI_API_KEY, OPENAI_MODEL
